NODE_ENV=development
PORT=3001

# Prisma CLI and NestJS both read this URL.
# Local: host port 5432. Docker Compose backend: host is the service name `postgres`.
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/fullstack_base

# Used by docker-compose to create the database (must match DATABASE_URL user/password/db).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=fullstack_base

JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:3000

INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=ChangeMe!Admin12

APP_NAME=Fullstack Base

# Places API (New) — Text Search Enterprise fields (phone, website, hours).
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key

# Lower memory cost only for local tests if needed (default 65536)
# ARGON2_MEMORY_COST=65536
# ARGON2_TIME_COST=3

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Fullstack Base
