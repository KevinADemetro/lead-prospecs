// PostgreSQL schema — source of truth for tables, indexes and relations.
// After changing this file: pnpm db:migrate (dev) or pnpm db:migrate:deploy (prod).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
}

// Values mirrored in packages/shared/src/constants.ts.
enum CampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// NOT_FOUND = verified absence; ERROR = the verification itself failed.
enum WebsiteStatus {
  FOUND
  NOT_FOUND
  UNAVAILABLE
  ERROR
  UNKNOWN
}

enum WhatsappStatus {
  CONFIRMED
  NOT_FOUND
  UNKNOWN
}

enum PresenceStatus {
  UNKNOWN
  NOT_FOUND
  FOUND
}

enum QualificationStatus {
  PENDING
  QUALIFIED
  DISQUALIFIED
}

enum TrelloStatus {
  NOT_SENT
  CREATED
  ERROR
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String    @default("")
  permissions String[]
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @db.Uuid @map("deleted_by")
  users       UserRole[]

  @@unique([name])
  @@index([deletedAt, createdAt])
  @@map("roles")
}

model User {
  id                  String         @id @default(uuid()) @db.Uuid
  login               String
  passwordHash        String         @map("password_hash")
  status              UserStatus     @default(active)
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?      @map("locked_until")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")
  deletedBy           String?        @db.Uuid @map("deleted_by")
  roles               UserRole[]
  refreshTokens       RefreshToken[]

  @@unique([login])
  @@index([status, createdAt])
  @@index([deletedAt, createdAt])
  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique @map("token_hash")
  familyId       String    @map("family_id")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedByHash String    @default("") @map("replaced_by_hash")
  userAgent      String    @default("") @map("user_agent")
  ip             String    @default("")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String         @default("")
  location    String
  city        String         @default("")
  state       String         @default("") @db.VarChar(2)
  categories  String[]
  searchTerms String[]       @map("search_terms")
  filters     Json           @default("{}")
  status      CampaignStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")
  deletedBy   String?        @db.Uuid @map("deleted_by")
  leads       Lead[]

  @@index([status, createdAt])
  @@index([deletedAt, createdAt])
  @@map("campaigns")
}

// Deduplication: cnpj > google_place_id > dedupe_key (normalized name + phone + address).
// Unique constraints include soft-deleted rows so identities are never reused.
model Company {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  legalName         String?   @map("legal_name")
  cnpj              String?   @unique @db.VarChar(14)
  category          String?
  phone             String?
  email             String?
  website           String?
  address           String?
  city              String?
  state             String?
  country           String?
  googlePlaceId     String?   @unique @map("google_place_id")
  googleMapsUrl     String?   @map("google_maps_url")
  googleRating      Float?    @map("google_rating")
  googleReviewCount Int?      @map("google_review_count")
  instagramUrl      String?   @map("instagram_url")
  facebookUrl       String?   @map("facebook_url")
  dedupeKey         String?   @unique @map("dedupe_key")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @db.Uuid @map("deleted_by")
  leads             Lead[]

  @@index([deletedAt, createdAt])
  @@map("companies")
}

model Dor {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @db.Uuid @map("deleted_by")
  leads       Lead[]

  @@unique([name])
  @@index([deletedAt, createdAt])
  @@map("dores")
}

model Lead {
  id                  String              @id @default(uuid()) @db.Uuid
  companyId           String              @map("company_id") @db.Uuid
  campaignId          String              @map("campaign_id") @db.Uuid
  dorId               String?             @map("dor_id") @db.Uuid
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  campaign            Campaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  dor                 Dor?                @relation(fields: [dorId], references: [id], onDelete: Restrict)
  websiteStatus       WebsiteStatus       @default(UNKNOWN) @map("website_status")
  whatsappStatus      WhatsappStatus      @default(UNKNOWN) @map("whatsapp_status")
  instagramStatus     PresenceStatus      @default(UNKNOWN) @map("instagram_status")
  facebookStatus      PresenceStatus      @default(UNKNOWN) @map("facebook_status")
  score               Int?
  scoreReasons        String[]            @map("score_reasons")
  qualificationStatus QualificationStatus @default(PENDING) @map("qualification_status")
  trelloStatus        TrelloStatus        @default(NOT_SENT) @map("trello_status")
  trelloCardId        String?             @map("trello_card_id")
  trelloCardUrl       String?             @map("trello_card_url")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")
  deletedBy           String?             @db.Uuid @map("deleted_by")

  @@unique([campaignId, companyId])
  @@index([companyId])
  @@index([dorId])
  @@index([campaignId, qualificationStatus])
  @@index([deletedAt, createdAt])
  @@map("leads")
}
